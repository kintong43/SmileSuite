digraph G { graph [rankdir=LR, bgcolor="white", nodesep=0.36, ranksep=0.52, pad=0.12, splines=polyline]; node [shape=plain,fontname="Arial",fontsize=13]; edge [color="#555555",penwidth=1.1,arrowsize=0.8];
"tenants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>tenants</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="subdomain">subdomain</TD><TD ALIGN="RIGHT"></TD></TR><TR><TD ALIGN="LEFT" PORT="timezone">timezone</TD><TD ALIGN="RIGHT"></TD></TR></TABLE>>];
"shopify_connections" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>shopify_connections</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="shop_id">shop_id</TD><TD ALIGN="RIGHT"></TD></TR></TABLE>>];
"shopping_carts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>shopping_carts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="shopify_cart_id">shopify_cart_id</TD><TD ALIGN="RIGHT"></TD></TR></TABLE>>];
"appointments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>appointments</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="patient_id">patient_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="practitioner_id">practitioner_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="operatory_id">operatory_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="service_id">service_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="RIGHT"></TD></TR></TABLE>>];
"outbox_messages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>outbox_messages</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="resource_id">resource_id</TD><TD ALIGN="RIGHT">FK</TD></TR></TABLE>>];
"notification_deliveries" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>notification_deliveries</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="outbox_message_id">outbox_message_id</TD><TD ALIGN="RIGHT">FK</TD></TR></TABLE>>];
"tenants" -> "appointments" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
"tenants" -> "notification_deliveries" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
"outbox_messages" -> "notification_deliveries" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
"tenants" -> "outbox_messages" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
"appointments" -> "outbox_messages" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
"tenants" -> "shopify_connections" [dir=both, arrowtail="teetee",arrowhead="teeodot"];
"tenants" -> "shopping_carts" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
}
