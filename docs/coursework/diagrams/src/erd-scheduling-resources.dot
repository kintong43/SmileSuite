digraph G { graph [rankdir=LR, bgcolor="white", nodesep=0.36, ranksep=0.52, pad=0.12, splines=polyline]; node [shape=plain,fontname="Arial",fontsize=13]; edge [color="#555555",penwidth=1.1,arrowsize=0.8];
"services" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>services</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR></TABLE>>];
"operatories" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>operatories</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR></TABLE>>];
"practitioners" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>practitioners</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="RIGHT">FK</TD></TR></TABLE>>];
"practitioner_services" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>practitioner_services</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="practitioner_id">practitioner_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="service_id">service_id</TD><TD ALIGN="RIGHT">FK</TD></TR></TABLE>>];
"operatory_services" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dddddd" COLSPAN="2"><B>operatory_services</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="RIGHT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="tenant_id">tenant_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="operatory_id">operatory_id</TD><TD ALIGN="RIGHT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="service_id">service_id</TD><TD ALIGN="RIGHT">FK</TD></TR></TABLE>>];
"operatories" -> "operatory_services" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
"services" -> "operatory_services" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
"practitioners" -> "practitioner_services" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
"services" -> "practitioner_services" [dir=both, arrowtail="teetee",arrowhead="crowodot"];
}
