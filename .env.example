APP_NAME=SmileSuite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://smilesuite.localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

TENANCY_DOMAIN=smilesuite.localhost
PLATFORM_HOSTS=smilesuite.localhost,localhost,127.0.0.1,admin.smilesuite.localhost
ADMIN_HOST=admin.smilesuite.localhost
SMILESUITE_SANDBOX=true
LIVE_BILLING_ENABLED=false
LIVE_COMMERCE_ENABLED=false
REAL_PATIENT_DATA_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Synthetic local runtime only; replace credentials for any shared environment.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=smilesuite
DB_USERNAME=postgres
DB_PASSWORD=smilesuite-local
DB_URL=

# Host-only cookies: never set a parent-domain SESSION_DOMAIN.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_PREFIX=smilesuite-local-cache
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=smilesuite-local-database-

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.test
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"

CMS_URL=http://127.0.0.1:8055
CMS_ADMIN_URL=http://127.0.0.1:8055/admin
# Server-only scoped tokens. Populate locally; never expose through VITE_ variables.
CMS_TOKENS_JSON='{}'
